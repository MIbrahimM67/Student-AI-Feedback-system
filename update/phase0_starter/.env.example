# ============================================================================
# Phase 0 environment. Copy to .env and fill in.
# Never commit .env to git.
# ============================================================================

# Postgres
POSTGRES_PASSWORD=change_me_strong_random
APP_USER_PASSWORD=change_me_different_strong_random   # the API connects as this user (not superuser) so RLS is enforced

# DigitalOcean Gradient (serverless inference). Get from the DO console.
GRADIENT_API_KEY=
GRADIENT_BASE_URL=https://inference.do-ai.run/v1     # verify in the docs; this is the typical shape

# Models (override if you've evaluated alternatives)
GRADIENT_EMBED_MODEL=bge-m3
GRADIENT_RERANK_MODEL=bge-reranker-v2-m3
GRADIENT_MODEL_SPECIALIST=gpt-oss-120b
GRADIENT_MODEL_JUDGE=qwen3-32b
GRADIENT_MODEL_SENIOR=gpt-oss-120b
GRADIENT_MODEL_UTILITY=gpt-oss-20b

# Firebase (Auth + Storage only; data lives in Postgres)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
