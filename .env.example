# ============================================================================
# GradeWise v3 — Environment template
# Copy to .env and fill in. NEVER commit .env to git.
# ============================================================================

# Postgres (the main database — relational + vectors + graph)
POSTGRES_PASSWORD=change_me_strong_random
APP_USER_PASSWORD=change_me_different_strong_random

# DigitalOcean Gradient serverless inference
GRADIENT_API_KEY=
GRADIENT_BASE_URL=https://inference.do-ai.run/v1

# Models (verified against DO Gradient catalogue — update if names change)
GRADIENT_EMBED_MODEL=bge-m3
GRADIENT_RERANK_MODEL=bge-reranker-v2-m3
GRADIENT_MODEL_SPECIALIST=gpt-oss-120b
GRADIENT_MODEL_JUDGE=qwen3-32b
GRADIENT_MODEL_SENIOR=gpt-oss-120b
GRADIENT_MODEL_UTILITY=gpt-oss-20b

# Firebase (Auth + Storage ONLY — all data lives in Postgres)
FIREBASE_PROJECT_ID=ai-student-feedback-system
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=ai-student-feedback-system.firebasestorage.app

# Frontend (set this after deploying the backend to get its public URL)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
