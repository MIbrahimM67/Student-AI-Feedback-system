# ============================================================================
# GradeWise v3 - Production Environment Template
# Copy to .env on the DigitalOcean droplet and fill in real secrets.
# ============================================================================

# Postgres
POSTGRES_PASSWORD=change_me_strong_random
APP_USER_PASSWORD=change_me_different_strong_random

# DigitalOcean Gradient serverless inference
GRADIENT_API_KEY=
GRADIENT_BASE_URL=https://inference.do-ai.run/v1
GRADIENT_MODEL_SPECIALIST=openai-gpt-oss-120b
GRADIENT_MODEL_JUDGE=qwen3-32b
GRADIENT_MODEL_SENIOR=openai-gpt-oss-120b
GRADIENT_MODEL_UTILITY=openai-gpt-oss-20b
GRADIENT_EMBED_MODEL=bge-m3
GRADIENT_RERANK_MODEL=bge-reranker-v2-m3

# Optional vision model for diagrams, flowcharts, scanned PDFs, and design images
GRADIENT_VISION_OCR_MODEL=
VISUAL_EXTRACTION_ENABLED=true
VISUAL_EXTRACTION_MAX_PDF_PAGES=8

# Groq / dedicated OpenAI-compatible endpoint for large-context grading
DEDICATED_INFERENCE_BASE_URL=
DEDICATED_INFERENCE_TOKEN=
DEDICATED_MODEL=llama-3.3-70b-versatile
DEDICATED_FALLBACK_BASE_URL=
DEDICATED_FALLBACK_TOKEN=
DEDICATED_FALLBACK_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional Groq / dedicated vision endpoint. If base/token are blank, the app
# reuses DEDICATED_INFERENCE_BASE_URL and DEDICATED_INFERENCE_TOKEN.
DEDICATED_VISION_BASE_URL=
DEDICATED_VISION_TOKEN=
DEDICATED_VISION_MODEL=

# Firebase (Auth + Storage only; all app data lives in Postgres)
FIREBASE_PROJECT_ID=ai-student-feedback-system
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=ai-student-feedback-system.firebasestorage.app

# Frontend
NEXT_PUBLIC_API_BASE_URL=http://168.144.116.93:8000
