# Copy this file to .env.aws in the repository root. Never commit the copy.
# Keep values on a single line. Use literal \n escapes inside the quoted PEM.
# Generate TWO DIFFERENT passwords with: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_USER_PASSWORD=
API_DOMAIN=
TLS_EMAIL=
FRONTEND_URL=https://student-ai-feedback-system.vercel.app
DEBUG=false
USE_MOCKS=false

# Required: moving the VM does not replace DigitalOcean AI inference.
GRADIENT_API_KEY=
GRADIENT_BASE_URL=https://inference.do-ai.run/v1
GRADIENT_MODEL_SPECIALIST=openai-gpt-oss-120b
GRADIENT_MODEL_JUDGE=qwen3-32b
GRADIENT_MODEL_SENIOR=openai-gpt-oss-120b
GRADIENT_MODEL_UTILITY=openai-gpt-oss-20b
GRADIENT_EMBED_MODEL=bge-m3
GRADIENT_RERANK_MODEL=bge-reranker-v2-m3
GRADIENT_VISION_OCR_MODEL=
VISUAL_EXTRACTION_ENABLED=true
VISUAL_EXTRACTION_MAX_PDF_PAGES=20
VISUAL_EXTRACTION_PAGE_DELAY_SECONDS=6.0

FIREBASE_PROJECT_ID=ai-student-feedback-system
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=ai-student-feedback-system.firebasestorage.app

# Optional existing providers/features. Restore their original values if used.
DEDICATED_INFERENCE_BASE_URL=
DEDICATED_INFERENCE_TOKEN=
DEDICATED_MODEL=llama-3.3-70b-versatile
DEDICATED_FALLBACK_BASE_URL=
DEDICATED_FALLBACK_TOKEN=
DEDICATED_FALLBACK_MODEL=
DEDICATED_VISION_BASE_URL=
DEDICATED_VISION_TOKEN=
DEDICATED_VISION_MODEL=
DIGITALOCEAN_WEB_SEARCH_AGENT_URL=
DIGITALOCEAN_WEB_SEARCH_AGENT_KEY=
INTERNET_PLAGIARISM_SEARCH_URL=
INTERNET_PLAGIARISM_SEARCH_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_INSTITUTION_PRICE_ID=
